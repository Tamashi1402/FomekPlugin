# Path to the extracted MCreator SOURCE CODE directory
# (source zip from https://github.com/MCreator/MCreator/releases -> 2026.2 -> Source code asset)
mcreator_path=E:/MCReator/MCreator-2026.2.33518

# MCreator 2026.2 needs Java 25 + JCEF.
# Easiest: run `gradlew downloadJDKWin64` (or downloadJDKLinux64 etc.) once inside
# the extracted MCreator source — it downloads the JetBrains Runtime SDK with JCEF
# into <mcreator source>/jdk/jbr25_win_64. Point this line at that JBR:
org.gradle.java.home=E:/MCReator/MCreator-2026.2.33518/jdk/jbr25_win_64
org.gradle.jvmargs=-Xmx3g
